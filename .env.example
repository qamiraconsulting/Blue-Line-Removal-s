# Copy this file to .env (already gitignored) and fill in real values.
# Never commit actual secrets -- this file documents shape only.

# ---------------------------------------------------------------- Quote form (needed now)

# Neon Postgres. FIRST create a dedicated database -- Neon SQL Editor: CREATE DATABASE blr_chatbot;
# Then dashboard -> Connect -> branch "production", database "blr_chatbot".
# BOTH strings must end in /blr_chatbot -- never the project's default database, which holds
# the older ElevenLabs-era tables.
# Pooled (Connection pooling ON) -- used by the app at runtime:
DATABASE_URL=
# Direct (Connection pooling OFF) -- used only by `npm run db:migrate`:
DATABASE_URL_UNPOOLED=

# Google Maps Platform -- one server-side key with ONLY "Routes API" enabled and the key
# restricted to that API (Cloud Console -> APIs & Services -> Credentials). Never exposed
# to the browser.
GOOGLE_MAPS_SERVER_KEY=

# Resend (email). RESEND_API_KEY: resend.com -> API Keys -> Create (Sending access).
# LEAD_FROM_EMAIL: an address on a domain verified in Resend (copy the current value from
# Vercel -> Settings -> Environment Variables).
RESEND_API_KEY=
LEAD_FROM_EMAIL=
# Optional: where new-quote notifications go (defaults to qamiraconsulting@gmail.com).
LEAD_TO_EMAIL=

# Local/preview ONLY: lets the placeholder rate card produce a price so the flow can be
# tested end to end. Ignored in Vercel Production, and while it's on no price is ever
# emailed to a customer -- only the team gets a "TEST MODE" email.
QUOTE_ALLOW_PLACEHOLDER=true

# ---------------------------------------------------------------- Recommended before launch

# Upstash Redis -- rate limits the public quote form (every submission costs a Google
# lookup and an email). console.upstash.com -> create a Redis database (Sydney) -> REST API.
# Unset = no rate limiting (fine locally).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- Admin dashboard (/admin)

# Clerk -- Clerk dashboard -> your app -> Configure -> API keys. Publishable key is safe in
# the browser; the secret key is server-only and verifies sessions on /api/admin/*.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ---------------------------------------------------------------- Chat assistant

# Needed for the chat widget (it prices with the same engine as the quote form, so it also
# needs DATABASE_URL, RESEND_API_KEY / LEAD_FROM_EMAIL and GOOGLE_MAPS_SERVER_KEY above).
# Where: console.anthropic.com -> Settings -> API Keys -> Create Key. Set a monthly spend
# limit under Settings -> Limits. Without this key the chat says it isn't configured and
# points people to the quote form.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5.
# ANTHROPIC_MODEL=
