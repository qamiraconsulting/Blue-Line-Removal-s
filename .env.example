# Copy this file to .env (already gitignored) and fill in real values.
# Never commit actual secrets -- this file documents shape only.

# Neon Postgres -- from the "Connect" button on the Neon project dashboard.
DATABASE_URL=

# Anthropic -- for the chat assistant's conversation + tool calling.
ANTHROPIC_API_KEY=

# Google Maps Platform -- server-side key (Geocoding, Places, Routes).
# Separate from any client-side/browser-restricted key -- never the same
# credential, per the architecture doc's Section 13 note.
GOOGLE_MAPS_SERVER_KEY=

# Upstash Redis -- rate limiting on /api/chat/message. Optional locally;
# rateLimit.ts fails open (allows requests) when these are unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Clerk -- gates the internal lead-review dashboard (/admin) only. Not used
# by the customer-facing chat, which stays deliberately login-free.
# Get both from the Clerk dashboard's "API Keys" page (not the project
# overview page) -- the publishable key is safe client-side, the secret key
# is server-only and verifies sessions on the /api/admin/* routes.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
