# Copy this file to .env (already gitignored) and fill in real values.
# Never commit actual secrets -- this file documents shape only.

# ---------------------------------------------------------------- Quote form (needed now)

# Neon Postgres. FIRST create a dedicated database -- Neon SQL Editor: CREATE DATABASE blr_chatbot;
# Then dashboard -> Connect -> branch "production", database "blr_chatbot".
# BOTH strings must end in /blr_chatbot -- never the project's default database, which holds
# the older ElevenLabs-era tables.
# Pooled (Connection pooling ON) -- used by the app at runtime:
DATABASE_URL=
# Direct (Connection pooling OFF) -- used only to create the tables:
DATABASE_URL_UNPOOLED=
# Then create the tables with:  npm run db:setup
# (checks first: refuses unless connected to blr_chatbot and the database holds no other
#  tables; only ever creates. `npm run db:setup -- --check` checks without changing anything.)

# Google Maps Platform -- one server-side key with ONLY "Routes API" enabled and the key
# restricted to that API (Cloud Console -> APIs & Services -> Credentials). Never exposed
# to the browser.
GOOGLE_MAPS_SERVER_KEY=

# Resend (email). RESEND_API_KEY: resend.com -> API Keys -> Create (Sending access).
# LEAD_FROM_EMAIL: an address on a domain verified in Resend (copy the current value from
# Vercel -> Settings -> Environment Variables).
RESEND_API_KEY=
LEAD_FROM_EMAIL=
# Optional: where team notifications go (defaults to hello@bluelineremovals.com.au).
LEAD_TO_EMAIL=

# Local/preview ONLY: lets the placeholder rate card produce a price so the flow can be
# tested end to end. Ignored in Vercel Production, and while it's on no price is ever
# emailed to a customer -- only the team gets a "TEST MODE" email.
QUOTE_ALLOW_PLACEHOLDER=true

# ---------------------------------------------------------------- Branded PDF quotes + Matt's Google Form

# The quote Apps Script's web app (docs/apps-script/blr-website-additions.gs): its ".../exec" URL,
# and the shared password (BLR_SHARED_SECRET in the script's Script Properties). The same
# password lets the script post Matt's Google Form rows to /api/intake. Unset = website and
# chat quotes go as a plain email, and /api/intake refuses everything.
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=

# Local/preview ONLY: while prices are test figures, customer emails (estimates, booking
# requests, PDF quotes) go to THIS inbox instead, marked [TEST]. Ignored in Production.
TEST_EMAIL_REDIRECT=

# The booking deposit ($100 when the move is 7+ days away), paid on a Stripe page made for each
# booking -- by card, or straight from a bank account with PayTo once it's switched on in Stripe.
# When Stripe says it's paid, the booking is confirmed automatically if its time is still free.
# Unset = customers are told the team will send a payment link.
#   STRIPE_SECRET_KEY: Stripe -> Developers -> API keys. Best: a restricted key (rk_...) with only
#     "Checkout Sessions: Write". Test keys (sk_test_/rk_test_) take test cards only.
#   STRIPE_WEBHOOK_SECRET: Stripe -> Developers -> Webhooks -> add endpoint
#     <site>/api/stripe/webhook with events checkout.session.completed,
#     checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#     checkout.session.expired -> its "Signing secret" (whsec_...).
#     On a protected Vercel preview, add ?x-vercel-protection-bypass=<secret> to that URL
#     (Vercel -> Settings -> Deployment Protection -> Protection Bypass for Automation).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Optional: where Stripe sends customers back to after paying (default: this deployment's URL).
# SITE_URL=https://www.bluelineremovals.com.au

# ---------------------------------------------------------------- Recommended before launch

# Upstash Redis -- rate limits the public quote form (every submission costs a Google
# lookup and an email). console.upstash.com -> create a Redis database (Sydney) -> REST API.
# Unset = no rate limiting (fine locally).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------- Admin dashboard (/admin)

# Clerk -- Clerk dashboard -> your app -> Configure -> API keys. Publishable key is safe in
# the browser; the secret key is server-only and verifies sessions on /api/admin/*.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Who may open the dashboard, by the VERIFIED email they sign in with (comma-separated):
#   ADMIN_EMAILS          full access
#   ADMIN_LIMITED_EMAILS  bookings, trucks and drivers per job -- no Settings (e.g. Matt)
# ADMIN_USER_IDS (Clerk user IDs, user_...) also gives full access. All empty = nobody gets in,
# even with a valid sign-in.
ADMIN_EMAILS=
ADMIN_LIMITED_EMAILS=
ADMIN_USER_IDS=

# Where the "job has no driver 2 days before the move" alert goes. Default:
# bluelineremovalsau@gmail.com. On previews it goes to TEST_EMAIL_REDIRECT when that's set.
DISPATCH_ALERT_EMAIL=

# ---------------------------------------------------------------- Chat assistant

# Needed for the chat widget (it prices with the same engine as the quote form, so it also
# needs DATABASE_URL, RESEND_API_KEY / LEAD_FROM_EMAIL and GOOGLE_MAPS_SERVER_KEY above).
# Where: console.anthropic.com -> Settings -> API Keys -> Create Key. Set a monthly spend
# limit under Settings -> Limits. Without this key the chat says it isn't configured and
# points people to the quote form.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5 at "low" effort (quick, cheap chat turns).
# ANTHROPIC_MODEL=
# ANTHROPIC_EFFORT=low

# ---------------------------------------------------------------- Trying it locally
# `npm run dev` also serves the api/ functions (dev/vercelApiDev.ts) using this .env, so the
# chat, quote form and dashboard work at http://localhost:5173. Open /api/health to see
# which of the keys above are picked up.

# Day-before emails to drivers and customers (api/cron/notices.ts, hourly from vercel.json).
# Any long random string; Vercel sends it to the cron job. Production only -- previews do not run cron jobs.
CRON_SECRET=

# The chat on the website: on (default) | preview (only with ?chat=1, for a soft launch) | off.
VITE_CHAT_MODE=

# Take the $100 deposit on bookings 7+ days ahead (needs the Stripe keys). Unset = no deposits.
DEPOSITS_ENABLED=
