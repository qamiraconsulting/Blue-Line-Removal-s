{
  "buildCommand": "npm run build",
  "outputDirectory": "build/client",
  "functions": {
    "api/chat/message.ts": { "maxDuration": 60 },
    "api/quote.ts": { "maxDuration": 30 },
    "api/booking.ts": { "maxDuration": 60 },
    "api/admin/jobs.ts": { "maxDuration": 60 },
    "api/intake.ts": { "maxDuration": 30 }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/__spa-fallback.html" }]
}
